{
  "manifest_version": 3,
  "name": "Sidecove",
  "version": "1.0.0",
  "description": "Vertical tabs in Chrome's side panel: switch between spaces, keep pinned tabs and favourites, auto-archive idle tabs. Free and open.",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "bookmarks",
    "alarms",
    "commands",
    "favicon",
    "scripting",
    "clipboardWrite",
    "offscreen"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.js",
        "onboarding.js",
        "installation-onboarding.js",
        "assets/*",
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ]
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle side panel"
    },
    "quickPinToggle": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Quick Pin/Unpin Tab"
    },
    "NextTabInSpace": {
      "description": "Navigates to next tab in space"
    },
    "PrevTabInSpace": {
      "description": "Navigates to prev tab in space"
    },
    "copyCurrentUrl": {
      "description": "Copy current tab URL"
    }
  },
  "options_page": "options.html"
}
