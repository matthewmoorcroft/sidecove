{
  "manifest_version": 3,
  "name": "Sidecove",
  "version": "1.0.1",
  "description": "Vertical tabs in Chrome's side panel: switch between spaces, keep pinned tabs and favourites, auto-archive idle tabs. Free and open.",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "bookmarks",
    "alarms",
    "favicon",
    "clipboardWrite",
    "offscreen"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle side panel"
    },
    "quickPinToggle": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Quick Pin/Unpin Tab"
    },
    "NextTabInSpace": {
      "description": "Navigates to next tab in space"
    },
    "PrevTabInSpace": {
      "description": "Navigates to prev tab in space"
    },
    "copyCurrentUrl": {
      "description": "Copy current tab URL"
    },
    "NextSpace": {
      "description": "Switch to the next space"
    },
    "PrevSpace": {
      "description": "Switch to the previous space"
    },
    "SwitchToSpace1": {
      "description": "Switch to space 1"
    },
    "SwitchToSpace2": {
      "description": "Switch to space 2"
    },
    "SwitchToSpace3": {
      "description": "Switch to space 3"
    },
    "SwitchToSpace4": {
      "description": "Switch to space 4"
    },
    "SwitchToSpace5": {
      "description": "Switch to space 5"
    },
    "SwitchToSpace6": {
      "description": "Switch to space 6"
    },
    "SwitchToSpace7": {
      "description": "Switch to space 7"
    },
    "SwitchToSpace8": {
      "description": "Switch to space 8"
    },
    "SwitchToSpace9": {
      "description": "Switch to the last space"
    }
  },
  "options_page": "options.html"
}
